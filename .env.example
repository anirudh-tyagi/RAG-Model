# ---------------------------------------------------------------------------
# Copy to .env and fill in. Only LLM_API_KEY is strictly required.
# ---------------------------------------------------------------------------

# --- LLM --------------------------------------------------------------------
# Any OpenAI-compatible endpoint works; only the base URL and model change.
#   Groq         https://api.groq.com/openai/v1   (default; key: console.groq.com/keys)
#   Ollama Cloud https://ollama.com/v1            (key: ollama.com/settings/keys)
#   OpenAI       https://api.openai.com/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Low by default: answers should follow the retrieved passages, not improvise.
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=120

# --- Vision (figure captioning) ---------------------------------------------
# Set separately because your chat provider may not host a multimodal model —
# Groq currently does not. Leave the URL and key unset to reuse the chat
# provider above. Requires CAPTION_IMAGES=true to do anything.
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
VISION_BASE_URL=
VISION_API_KEY=

# --- Vector store -----------------------------------------------------------
# Inside docker compose this is http://qdrant:6333 (set in the compose file).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# --- Queue / state ----------------------------------------------------------
# Inside docker compose this is redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# --- Embeddings & reranking (ONNX via fastembed, no torch needed) -----------
# Swap DENSE_MODEL to BAAI/bge-base-en-v1.5 for ~3x faster CPU ingestion
# at a small quality cost. Changing it requires re-indexing (different dims).
DENSE_MODEL=BAAI/bge-large-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_ENABLED=true

# --- Retrieval tuning -------------------------------------------------------
RETRIEVAL_CANDIDATES=40
RETRIEVAL_TOP_K=6
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
# How many past messages are replayed into the prompt on each turn.
HISTORY_TURNS=6

# --- Ingestion --------------------------------------------------------------
# pymupdf  = fast, no torch, good enough for most PDFs (default)
# docling  = higher quality layout/table extraction, needs the `docling` extra
PDF_PARSER=pymupdf
# Needs a vision-capable provider (see VISION_* above). Off by default.
CAPTION_IMAGES=false
# Each figure costs one vision call, so a 200-figure PDF is capped rather than
# quietly running up a bill. Concurrency bounds how many run at once.
MAX_CAPTIONS_PER_DOC=60
CAPTION_CONCURRENCY=4

# --- Speech to text (local faster-whisper, replaces Google Web Speech) ------
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
# Whisper translates any supported language straight to English.
WHISPER_TASK=translate

# --- Observability (all optional; tracing is a no-op when unset) ------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- API --------------------------------------------------------------------
DATA_DIR=./data
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Web --------------------------------------------------------------------
# Browser-visible API origin. Inside docker compose, leave as localhost:8000
# (the browser talks to the published port, not the container network).
NEXT_PUBLIC_API_URL=http://localhost:8000
