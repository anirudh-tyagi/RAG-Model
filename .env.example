# ---------------------------------------------------------------------------
# Copy to .env and fill in. Only OLLAMA_API_KEY is strictly required.
# ---------------------------------------------------------------------------

# --- LLM (Ollama Cloud) -----------------------------------------------------
# Get a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
LLM_MODEL=gpt-oss:120b
VISION_MODEL=qwen3-vl:235b-cloud

# --- Vector store -----------------------------------------------------------
# Inside docker compose this is http://qdrant:6333 (set in the compose file).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# --- Queue / state ----------------------------------------------------------
# Inside docker compose this is redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# --- Embeddings & reranking (ONNX via fastembed, no torch needed) -----------
# Swap DENSE_MODEL to BAAI/bge-base-en-v1.5 for ~3x faster CPU ingestion
# at a small quality cost. Changing it requires re-indexing (different dims).
DENSE_MODEL=BAAI/bge-large-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_ENABLED=true

# --- Retrieval tuning -------------------------------------------------------
RETRIEVAL_CANDIDATES=40
RETRIEVAL_TOP_K=6
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# --- Ingestion --------------------------------------------------------------
# pymupdf  = fast, no torch, good enough for most PDFs (default)
# docling  = higher quality layout/table extraction, needs the `docling` extra
PDF_PARSER=pymupdf
CAPTION_IMAGES=true

# --- Speech to text (local faster-whisper, replaces Google Web Speech) ------
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
# Whisper translates any supported language straight to English.
WHISPER_TASK=translate

# --- Observability (all optional; tracing is a no-op when unset) ------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- API --------------------------------------------------------------------
DATA_DIR=./data
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Web --------------------------------------------------------------------
# Browser-visible API origin. Inside docker compose, leave as localhost:8000
# (the browser talks to the published port, not the container network).
NEXT_PUBLIC_API_URL=http://localhost:8000
